---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Infinito Dinero: descubre plataformas, aplicaciones, criptomonedas, trading y oportunidades para ganar dinero por Internet." />
  <meta name="theme-color" content="#070B16" />
  <title>Infinito Dinero | Oportunidades para ganar por Internet</title>
</head>

<body>

<header class="header">
  <a href="#inicio" class="logo">
    <span class="logo-icon">∞</span>
    <span>INFINITO <b>DINERO</b></span>
  </a>

  <div class="header-navigation">
    <nav aria-label="Navegación principal">
      <a href="#inicio">Inicio</a>
      <a href="#categorias">Categorías</a>
      <a href="#trading">Trading</a>
      <a href="#contacto">Contacto</a>
    </nav>

    <div class="social-links">
      <a href="https://youtube.com/@infinitodinero"
         class="social-icon youtube"
         target="_blank"
         rel="noopener noreferrer"
         aria-label="YouTube">▶</a>

      <a href="https://t.me/TU_CANAL"
         class="social-icon telegram"
         target="_blank"
         rel="noopener noreferrer"
         aria-label="Telegram">➤</a>
    </div>
  </div>
</header>

<main>

  <!-- PORTADA -->
  <section class="hero" id="inicio">
    <div class="hero-content">

      <span class="eyebrow">✦ BIENVENIDO A INFINITO DINERO</span>

      <h1>
        Descubre nuevas formas de
        <span>ganar dinero</span> por Internet.
      </h1>

      <p>
        Explora plataformas, aplicaciones, criptomonedas,
        trading y oportunidades para generar ingresos desde Internet.
      </p>

      <div class="hero-actions">
        <a class="primary-button" href="#categorias">
          Explorar oportunidades →
        </a>

        <a class="secondary-button"
           href="https://youtube.com/@infinitodinero"
           target="_blank">
          Ver canal de YouTube
        </a>
      </div>

      <div class="hero-note">
        <span class="pulse"></span>
        INFORMACIÓN, GUÍAS Y TUTORIALES EN UN SOLO LUGAR
      </div>
    </div>

    <div class="hero-visual">
      <div class="visual-card">
        <span class="visual-label">INFINITO DINERO</span>

        <div class="infinity">∞</div>

        <div class="visual-line"></div>

        <div class="visual-bottom">
          <span>OPORTUNIDADES</span>
          <span class="gold-text">SIN LÍMITES</span>
        </div>
      </div>

      <div class="floating-tag tag-one">
        ↗ Nuevas oportunidades
      </div>

      <div class="floating-tag tag-two">
        ◆ Aprende y descubre
      </div>
    </div>
  </section>


  <!-- CATEGORÍAS -->
  <section class="categories section" id="categorias">

    <div class="section-heading">
      <div>
        <span class="eyebrow">EXPLORA Y DESCUBRE</span>
        <h2>Encuentra tu oportunidad</h2>
      </div>

      <p>
        Distintas categorías para descubrir nuevas formas
        de ganar por Internet.
      </p>
    </div>

    <div class="category-grid">

      <a class="category-card" href="#ingresos">
        <span class="card-icon">↗</span>
        <span class="card-number">01 / INGRESOS</span>
        <h3>Ingresos pasivos</h3>
        <p>
          Aplicaciones y plataformas para explorar
          alternativas de ingresos.
        </p>
        <span class="card-link">Explorar categoría →</span>
      </a>

      <a class="category-card" href="#cripto">
        <span class="card-icon">₿</span>
        <span class="card-number">02 / CRIPTOMONEDAS</span>
        <h3>Criptomonedas</h3>
        <p>
          Faucets, recompensas, plataformas y recursos
          del mundo cripto.
        </p>
        <span class="card-link">Explorar categoría →</span>
      </a>

      <a class="category-card" href="#encuestas">
        <span class="card-icon">▤</span>
        <span class="card-number">03 / ENCUESTAS</span>
        <h3>Encuestas remuneradas</h3>
        <p>
          Descubre páginas que ofrecen recompensas
          por participar.
        </p>
        <span class="card-link">Explorar categoría →</span>
      </a>

      <a class="category-card" href="#tareas">
        <span class="card-icon">⌘</span>
        <span class="card-number">04 / TAREAS Y OFERTAS</span>
        <h3>Tareas y ofertas</h3>
        <p>
          Plataformas de pequeñas tareas, ofertas
          y promociones.
        </p>
        <span class="card-link">Explorar categoría →</span>
      </a>

      <a class="category-card trading-card" href="#trading" id="trading">
        <span class="card-icon">📈</span>
        <span class="card-number">05 / TRADING</span>
        <h3>Trading e inversiones</h3>
        <p>
          Plataformas, brokers, herramientas,
          estrategias y formación para aprender
          a operar en los mercados.
        </p>
        <span class="card-link">Explorar categoría →</span>
      </a>

    </div>
  </section>


  <!-- PAGOS -->
  <section class="proof section" id="pagos">

    <div class="proof-content">
      <span class="eyebrow">TRANSPARENCIA Y EXPERIENCIA</span>

      <h2>Los pagos también cuentan.</h2>

      <p>
        Consulta nuestros vídeos y publicaciones sobre pagos recibidos,
        experiencias con plataformas y comprobaciones de cobros.
      </p>

      <a class="primary-button"
         href="https://youtube.com/@infinitodinero"
         target="_blank">
        Ver pagos y experiencias →
      </a>
    </div>

    <div class="proof-symbol">
      <span>€</span>
      <small>COBROS Y EXPERIENCIAS</small>
      <strong>INFINITO DINERO</strong>
    </div>

  </section>


  <!-- TUTORIALES -->
  <section class="tutorials section" id="tutoriales">

    <span class="eyebrow">APRENDE PASO A PASO</span>

    <h2>Todo explicado en nuestro canal</h2>

    <p>
      Guías, tutoriales, plataformas y experiencias
      para ayudarte a conocer nuevas oportunidades.
    </p>

    <a class="youtube-button"
       href="https://youtube.com/@infinitodinero"
       target="_blank">
      ▶ Visitar INFINITO DINERO en YouTube
    </a>

  </section>


  <!-- MÁS CONTENIDO -->
  <section class="extra-section section">

    <div class="section-heading">
      <div>
        <span class="eyebrow">DESCUBRE MÁS</span>
        <h2>Seguimos creciendo</h2>
      </div>
    </div>

    <div class="extra-grid">

      <a href="#tutoriales" id="ingresos">
        Ingresos pasivos <span>↗</span>
      </a>

      <a href="#tutoriales" id="cripto">
        Criptomonedas <span>↗</span>
      </a>

      <a href="#tutoriales" id="encuestas">
        Encuestas remuneradas <span>↗</span>
      </a>

      <a href="#tutoriales" id="tareas">
        Tareas y ofertas <span>↗</span>
      </a>

    </div>
  </section>


  <!-- CONTACTO -->
  <section class="contact-section section" id="contacto">

    <span class="eyebrow">ESTAMOS EN CONTACTO</span>

    <h2>¿Tienes alguna pregunta?</h2>

    <p>
      Encuentra más contenido, novedades y tutoriales
      en nuestros canales.
    </p>

    <div class="contact-actions">

      <a class="primary-button"
         href="https://youtube.com/@infinitodinero"
         target="_blank">
        YouTube ↗
      </a>

      <a class="secondary-button"
         href="https://t.me/TU_CANAL"
         target="_blank">
        Únete a Telegram ↗
      </a>

    </div>
  </section>

</main>


<!-- FOOTER -->
<footer class="site-footer">

  <a href="#inicio" class="logo footer-logo">
    <span class="logo-icon">∞</span>
    <span>INFINITO <b>DINERO</b></span>
  </a>

  <p>
    Información, guías y oportunidades
    para ganar dinero por Internet.
  </p>

  <div class="footer-links">
    <a href="#inicio">Inicio</a>
    <a href="#categorias">Categorías</a>
    <a href="#trading">Trading</a>
    <a href="#contacto">Contacto</a>
  </div>

  <div class="footer-social">
    <a href="https://youtube.com/@infinitodinero" target="_blank">
      YouTube
    </a>

    <a href="https://t.me/TU_CANAL" target="_blank">
      Telegram
    </a>
  </div>

  <small>
    © 2026 INFINITO DINERO. Todos los derechos reservados.
  </small>

</footer>

</body>
</html>


<style>

:global(*) {
  box-sizing: border-box;
}

:global(html) {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

:global(body) {
  margin: 0;
  background: #070B16;
  color: #F4F6FA;
  font-family: Arial, Helvetica, sans-serif;
}

:global(a) {
  color: inherit;
  text-decoration: none;
}

:global(a:focus-visible) {
  outline: 2px solid #F5B936;
  outline-offset: 4px;
}


/* CABECERA */

.header {
  min-height: 82px;
  padding: 12px 5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  background: #070B16;
  border-bottom: 1px solid #263B5B;
  position: relative;
  z-index: 10;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 15px;
  letter-spacing: 1px;
  font-weight: 700;
  white-space: nowrap;
}

.logo b,
.logo-icon {
  color: #F5B936;
}

.logo-icon {
  font-size: 39px;
  text-shadow: 0 0 18px #087BFF88;
}

.header-navigation {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22px;
  flex: 1;
  min-width: 0;
}

nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(14px, 2vw, 28px);
  white-space: nowrap;
}

nav a {
  color: #D0D7E5;
  font-size: 13px;
  font-weight: 600;
  transition: color .2s;
}

nav a:hover {
  color: #F5B936;
}

.social-links {
  display: flex;
  align-items: center;
  gap: 10px;
  padding-left: 18px;
  border-left: 1px solid #283754;
}

.social-icon {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #101D33;
  font-size: 15px;
  font-weight: bold;
  transition: .2s;
}

.social-icon:hover {
  transform: translateY(-2px);
  background: #1A3155;
}

.youtube {
  color: #FF454F;
}

.telegram {
  color: #35BDF5;
}


/* PORTADA */

.hero {
  min-height: 550px;
  padding: 82px 9%;
  display: grid;
  grid-template-columns: 1.15fr .85fr;
  align-items: center;
  gap: 55px;
  background: radial-gradient(
    ellipse at 80% 40%,
    #102B52 0%,
    #0A1428 38%,
    #070B16 72%
  );
}

.eyebrow {
  color: #39A4FF;
  font-size: 11px;
  letter-spacing: 2px;
  font-weight: 800;
}

h1 {
  font-size: clamp(38px, 5vw, 62px);
  line-height: 1.1;
  letter-spacing: -2px;
  margin: 24px 0;
  max-width: 660px;
}

h1 span {
  color: #F5B936;
}

.hero-content > p,
.section-heading > p,
.proof-content > p,
.tutorials > p,
.contact-section > p {
  color: #A6B1C4;
  line-height: 1.8;
  font-size: 15px;
  max-width: 550px;
}

.hero-actions,
.contact-actions {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  margin-top: 30px;
}

.primary-button,
.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 13px 20px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 700;
  transition: .2s;
}

.primary-button {
  background: linear-gradient(110deg, #F8D36B, #D99A20);
  color: #07101D;
  box-shadow: 0 7px 24px #D99A2028;
}

.primary-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 28px #D99A2044;
}

.secondary-button {
  border: 1px solid #31517E;
  color: #E2EAF7;
  background: #0C1830;
}

.secondary-button:hover {
  border-color: #2998FF;
  color: #69BDFF;
}

.hero-note {
  margin-top: 40px;
  color: #8D9BB2;
  font-size: 10px;
  letter-spacing: 1px;
}

.pulse {
  display: inline-block;
  width: 8px;
  height: 8px;
  background: #29A0FF;
  border-radius: 50%;
  margin-right: 8px;
  box-shadow: 0 0 12px #168BFF;
}


/* ELEMENTO VISUAL */

.hero-visual {
  position: relative;
  padding: 25px;
}

.visual-card {
  min-height: 315px;
  padding: 30px;
  border: 1px solid #246CC0;
  border-radius: 16px;
  background: linear-gradient(145deg, #142542, #0B1222);
  box-shadow: 0 20px 80px #0008;
}

.visual-label,
.visual-bottom {
  font-size: 10px;
  letter-spacing: 2px;
  color: #A9B8D0;
}

.infinity {
  font-size: 170px;
  line-height: 1.4;
  text-align: center;
  color: #F5B936;
  text-shadow: 0 0 25px #F5B93655, 0 0 40px #087BFF55;
}

.visual-line {
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    #D9A52F,
    #168BFF,
    transparent
  );
}

.visual-bottom {
  display: flex;
  justify-content: space-between;
  padding-top: 20px;
}

.gold-text {
  color: #F5B936;
}

.floating-tag {
  position: absolute;
  padding: 13px 17px;
  background: #111E35;
  border: 1px solid #29466D;
  border-radius: 7px;
  font-size: 12px;
  box-shadow: 0 8px 30px #0008;
}

.tag-one {
  top: 5px;
  right: -10px;
  color: #F5B936;
}

.tag-two {
  bottom: 0;
  left: -5px;
  color: #65B9FF;
}


/* SECCIONES */

.section {
  padding: 82px 9%;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 30px;
  margin-bottom: 35px;
}

h2 {
  font-size: clamp(28px, 4vw, 39px);
  letter-spacing: -1px;
  margin: 14px 0;
}


/* TARJETAS */

.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 17px;
}

.category-card {
  min-height: 255px;
  padding: 25px;
  border: 1px solid #263B5B;
  border-radius: 10px;
  background: linear-gradient(145deg, #101B2D, #0C1321);
  transition: .22s;
}

.category-card:hover {
  transform: translateY(-5px);
  border-color: #278FFF;
  box-shadow: 0 14px 35px #006DCE1C;
}

.card-icon {
  font-size: 28px;
  display: block;
  margin-bottom: 25px;
  color: #F5B936;
}

.card-number {
  color: #8192AD;
  font-size: 9px;
  letter-spacing: 1px;
}

.category-card h3 {
  font-size: 19px;
  margin: 13px 0;
}

.category-card p {
  color: #A6B1C4;
  font-size: 12px;
  line-height: 1.7;
  min-height: 60px;
}

.card-link {
  font-size: 11px;
  font-weight: 700;
  color: #55B2FF;
}

.trading-card {
  background: linear-gradient(145deg, #142542, #101728);
  border-color: #A77A2B66;
}


/* PAGOS */

.proof {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 35px;
  background: linear-gradient(110deg, #0D1A30, #101522);
  border-top: 1px solid #29466D;
  border-bottom: 1px solid #29466D;
}

.proof-content {
  max-width: 560px;
}

.proof-content > p {
  margin-bottom: 28px;
}

.proof-symbol {
  width: 270px;
  min-height: 230px;
  border: 1px solid #A77A2B;
  border-radius: 15px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #172642, #101725);
}

.proof-symbol span {
  font-size: 90px;
  color: #F5B936;
}

.proof-symbol small {
  color: #A6B1C4;
  letter-spacing: 2px;
  font-size: 9px;
}

.proof-symbol strong {
  color: #F5B936;
  font-size: 12px;
  margin-top: 15px;
}


/* TUTORIALES */

.tutorials {
  text-align: center;
  background: radial-gradient(
    ellipse at center,
    #102344 0%,
    #070B16 68%
  );
}

.tutorials > p,
.contact-section > p {
  margin: 0 auto 28px;
}

.youtube-button {
  display: inline-block;
  padding: 15px 22px;
  background: #C92D3C;
  color: white;
  border-radius: 6px;
  font-size: 13px;
  font-weight: bold;
  transition: .2s;
}

.youtube-button:hover {
  background: #E33B4B;
  transform: translateY(-2px);
}


/* MÁS CONTENIDO */

.extra-section {
  padding-top: 45px;
}

.extra-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.extra-grid a {
  background: #101A2B;
  border: 1px solid #263B5B;
  border-radius: 7px;
  padding: 20px;
  display: flex;
  justify-content: space-between;
  transition: .2s;
}

.extra-grid a:hover {
  border-color: #D9A52F;
}

.extra-grid a span {
  color: #F5B936;
}


/* CONTACTO */

.contact-section {
  text-align: center;
  background: linear-gradient(120deg, #0D1930, #0A1020);
  border-top: 1px solid #263B5B;
}

.contact-section > p {
  margin: 0 auto 28px;
}

.contact-actions {
  justify-content: center;
}


/* FOOTER */

.site-footer {
  padding: 48px 9% 30px;
  border-top: 1px solid #29466D;
  text-align: center;
  background: #060912;
}

.footer-logo {
  justify-content: center;
}

.site-footer p,
.site-footer small {
  color: #8998B0;
  font-size: 12px;
  line-height: 1.7;
}

.footer-links,
.footer-social {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 22px;
  margin-top: 22px;
}

.footer-links a,
.footer-social a {
  color: #B7C3D6;
  font-size: 12px;
}

.footer-links a:hover,
.footer-social a:hover {
  color: #F5B936;
}

.site-footer small {
  display: block;
  margin-top: 28px;
  padding-top: 20px;
  border-top: 1px solid #1B2940;
}


/* TABLETS */

@media (max-width: 1050px) {

  .header {
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }

  .header-navigation {
    flex: initial;
  }

}


/* MÓVILES */

@media (max-width: 700px) {

  .header {
    min-height: 0;
    padding: 12px 3%;
    gap: 12px;
  }

  .header-navigation {
    width: 100%;
    gap: 12px;
    justify-content: center;
  }

  nav {
    gap: 12px;
    overflow-x: auto;
  }

  nav a {
    font-size: 11px;
  }

  .social-links {
    gap: 6px;
    padding-left: 10px;
  }

  .social-icon {
    width: 25px;
    height: 25px;
    font-size: 13px;
  }

  .hero {
    grid-template-columns: 1fr;
    padding: 65px 7%;
  }

  .hero-visual {
    margin: 10px 0;
  }

  .infinity {
    font-size: 130px;
  }

  .section {
    padding: 60px 7%;
  }

  .section-heading,
  .proof {
    align-items: flex-start;
    flex-direction: column;
  }

  .category-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .proof-symbol {
    width: 100%;
  }

}


/* MÓVILES PEQUEÑOS */

@media (max-width: 430px) {

  .header-navigation {
    gap: 8px;
  }

  nav {
    gap: 8px;
  }

  nav a {
    font-size: 10px;
  }

  .social-links {
    gap: 4px;
    padding-left: 7px;
  }

  .category-grid,
  .extra-grid {
    grid-template-columns: 1fr;
  }

  .category-card {
    min-height: 225px;
  }

}


/* ACCESIBILIDAD */

@media (prefers-reduced-motion: reduce) {

  :global(html) {
    scroll-behavior: auto;
  }

  * {
    transition-duration: .01ms !important;
  }

}

</style>
