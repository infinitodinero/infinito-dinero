      .hero{padding:58px 0 55px}.hero-grid,.feature-grid,.rank-card{grid-template-columns:1fr}.hero-art{min-height:330px;margin:5px 8px 0}.emblem{max-width:360px}.float-one{right:-4px}.float-two{left:-4px}
      .section{padding:58px 0}.section-head{display:block}.section-head p{margin-top:12px}.cards{grid-template-columns:1fr}.card{min-height:0}.rank-features{grid-template-columns:1fr 1fr}.steps{grid-template-columns:1fr}.community-grid{grid-template-columns:1fr}
      h1{letter-spacing:-1.5px}.proof-panel{min-height:190px}
    }
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{transition:none!important}}
