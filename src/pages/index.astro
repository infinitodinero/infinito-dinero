<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="INFINITO DINERO: plataformas, criptomonedas, trading y oportunidades para ganar dinero por Internet." />
  <meta name="theme-color" content="#070B16" />
  <title>INFINITO DINERO | Oportunidades para ganar por Internet</title>
</head>

<body>

<!-- CABECERA Y MENÚ -->
<header class="header" id="inicio">

  <a href="#inicio" class="logo">
    <span class="logo-icon">∞</span>
    <span>INFINITO <b>DINERO</b></span>
  </a>

  <div class="header-navigation">

    <nav aria-label="Menú principal">
      <a href="#inicio">Inicio</a>
      <a href="#categorias">Categorías</a>
      <a href="#trading">Trading</a>
      <a href="#contacto">Contacto</a>
    </nav>

    <div class="social-links">

      <a href="https://youtube.com/@infinitodinero"
         class="social-button youtube"
         target="_blank"
         rel="noopener noreferrer">

        <span class="social-icon">▶</span>
        YouTube

      </a>

      <a href="https://t.me/TU_CANAL"
         class="social-button telegram"
         target="_blank"
         rel="noopener noreferrer">

        <span class="social-icon">➤</span>
        Telegram

      </a>

    </div>

  </div>
</header>


<main>

  <!-- PORTADA -->
  <section class="hero">

    <div class="hero-content">

      <span class="eyebrow">✦ BIENVENIDO A INFINITO DINERO</span>

      <h1>
        Descubre nuevas formas de
        <span>ganar dinero</span> por Internet.
      </h1>

      <p>
        Explora plataformas, aplicaciones, criptomonedas,
        trading y oportunidades para generar ingresos
        desde Internet.
      </p>

      <div class="hero-actions">

        <a class="primary-button" href="#categorias">
          Explorar oportunidades →
        </a>

        <a class="secondary-button"
           href="https://youtube.com/@infinitodinero"
           target="_blank"
           rel="noopener noreferrer">
          Ver canal de YouTube
        </a>

      </div>

      <div class="hero-note">
        <span class="pulse"></span>
        INFORMACIÓN, GUÍAS Y TUTORIALES EN UN SOLO LUGAR
      </div>

    </div>


    <!-- NUEVO EMBLEMA VISUAL -->
    <div class="hero-visual">

      <div class="brand-emblem">

        <div class="emblem-top">
          <span>INFINITO DINERO</span>
          <span class="emblem-star">✦</span>
        </div>

        <div class="emblem-globe">
          <div class="globe-line globe-line-one"></div>
          <div class="globe-line globe-line-two"></div>
          <div class="globe-line globe-line-three"></div>

          <div class="globe-symbol">🌐</div>
        </div>

        <div class="emblem-infinity">

          <svg viewBox="0 0 300 150"
               xmlns="http://www.w3.org/2000/svg"
               role="img"
               aria-label="Símbolo del infinito dorado y azul">

            <defs>
              <linearGradient id="infinityGold" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#FFF0A0"/>
                <stop offset="35%" stop-color="#F7B92E"/>
                <stop offset="65%" stop-color="#D98B12"/>
                <stop offset="100%" stop-color="#FFE17A"/>
              </linearGradient>

              <linearGradient id="infinityBlue" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#6EEBFF"/>
                <stop offset="45%" stop-color="#008BFF"/>
                <stop offset="100%" stop-color="#173EFF"/>
              </linearGradient>

              <filter id="glow">
                <feGaussianBlur stdDeviation="5" result="blur"/>
                <feMerge>
                  <feMergeNode in="blur"/>
                  <feMergeNode in="SourceGraphic"/>
                </feMerge>
              </filter>
            </defs>

            <path
              d="M150 75
                 C115 15 75 15 45 45
                 C5 85 45 135 85 115
                 C115 100 135 65 150 75
                 C165 85 185 120 215 115
                 C255 135 295 85 255 45
                 C225 15 185 15 150 75"
              fill="none"
              stroke="#050B19"
              stroke-width="25"
              stroke-linecap="round"
              transform="translate(0 5)"
            />

            <path
              d="M150 75
                 C115 15 75 15 45 45
                 C5 85 45 135 85 115
                 C115 100 135 65 150 75"
              fill="none"
              stroke="url(#infinityGold)"
              stroke-width="15"
              stroke-linecap="round"
              filter="url(#glow)"
            />

            <path
              d="M150 75
                 C165 85 185 120 215 115
                 C255 135 295 85 255 45
                 C225 15 185 15 150 75"
              fill="none"
              stroke="url(#infinityBlue)"
              stroke-width="15"
              stroke-linecap="round"
              filter="url(#glow)"
            />

          </svg>

        </div>

        <div class="emblem-title">
          <span>INFINITO</span>
          <strong>DINERO</strong>
        </div>

        <div class="emblem-divider"></div>

        <div class="emblem-bottom">
          <span>OPORTUNIDADES</span>
          <span>SIN LÍMITES</span>
        </div>

      </div>

      <div class="floating-tag tag-one">
        ↗ Nuevas oportunidades
      </div>

      <div class="floating-tag tag-two">
        ◆ Aprende y descubre
      </div>

    </div>

  </section>


  <!-- CATEGORÍAS -->
  <section class="categories section" id="categorias">

    <div class="section-heading">

      <div>
        <span class="eyebrow">EXPLORA Y DESCUBRE</span>
        <h2>Encuentra tu oportunidad</h2>
      </div>

      <p>
        Distintas categorías para descubrir nuevas formas
        de ganar por Internet.
      </p>

    </div>


    <div class="category-grid">

      <a class="category-card" href="#ingresos">

        <span class="card-icon">↗</span>
        <span class="card-number">01 / INGRESOS</span>

        <h3>Ingresos pasivos</h3>

        <p>
          Aplicaciones y plataformas para explorar
          alternativas de ingresos.
        </p>

        <span class="card-link">Explorar categoría →</span>

      </a>


      <a class="category-card" href="#cripto">

        <span class="card-icon">₿</span>
        <span class="card-number">02 / CRIPTOMONEDAS</span>

        <h3>Criptomonedas</h3>

        <p>
          Faucets, recompensas, plataformas y recursos
          del mundo cripto.
        </p>

        <span class="card-link">Explorar categoría →</span>

      </a>


      <a class="category-card" href="#encuestas">

        <span class="card-icon">▤</span>
        <span class="card-number">03 / ENCUESTAS</span>

        <h3>Encuestas remuneradas</h3>

        <p>
          Descubre páginas que ofrecen recompensas
          por participar.
        </p>

        <span class="card-link">Explorar categoría →</span>

      </a>


      <a class="category-card" href="#tareas">

        <span class="card-icon">⌘</span>
        <span class="card-number">04 / TAREAS Y OFERTAS</span>

        <h3>Tareas y ofertas</h3>

        <p>
          Plataformas de pequeñas tareas, ofertas
          y promociones.
        </p>

        <span class="card-link">Explorar categoría →</span>

      </a>


      <a class="category-card trading-card" href="#trading" id="trading">

        <span class="card-icon">📈</span>
        <span class="card-number">05 / TRADING</span>

        <h3>Trading e inversiones</h3>

        <p>
          Plataformas, brokers, herramientas, estrategias
          y formación para aprender a operar en los mercados.
        </p>

        <span class="card-link">Explorar categoría →</span>

      </a>

    </div>

  </section>


  <!-- PAGOS -->
  <section class="proof section" id="pagos">

    <div class="proof-content">

      <span class="eyebrow">TRANSPARENCIA Y EXPERIENCIA</span>

      <h2>Los pagos también cuentan.</h2>

      <p>
        Consulta nuestros vídeos y publicaciones sobre pagos
        recibidos, experiencias con plataformas y
        comprobaciones de cobros.
      </p>

      <a class="primary-button"
         href="https://youtube.com/@infinitodinero"
         target="_blank"
         rel="noopener noreferrer">

        Ver pagos y experiencias →

      </a>

    </div>


    <div class="proof-symbol">

      <span>€</span>
      <small>COBROS Y EXPERIENCIAS</small>
      <strong>INFINITO DINERO</strong>

    </div>

  </section>


  <!-- TUTORIALES -->
  <section class="tutorials section" id="tutoriales">

    <span class="eyebrow">APRENDE PASO A PASO</span>

    <h2>Todo explicado en nuestro canal</h2>

    <p>
      Guías, tutoriales, plataformas y experiencias
      para ayudarte a conocer nuevas oportunidades.
    </p>

    <a class="youtube-button"
       href="https://youtube.com/@infinitodinero"
       target="_blank"
       rel="noopener noreferrer">

      ▶ Visitar INFINITO DINERO en YouTube

    </a>

  </section>


  <!-- MÁS CONTENIDO -->
  <section class="extra-section section">

    <div class="section-heading">

      <div>
        <span class="eyebrow">DESCUBRE MÁS</span>
        <h2>Seguimos creciendo</h2>
      </div>

    </div>


    <div class="extra-grid">

      <a href="#tutoriales" id="ingresos">
        Ingresos pasivos <span>↗</span>
      </a>

      <a href="#tutoriales" id="cripto">
        Criptomonedas <span>↗</span>
      </a>

      <a href="#tutoriales" id="encuestas">
        Encuestas remuneradas <span>↗</span>
      </a>

      <a href="#tutoriales" id="tareas">
        Tareas y ofertas <span>↗</span>
      </a>

    </div>

  </section>


  <!-- CONTACTO -->
  <section class="contact-section section" id="contacto">

    <span class="eyebrow">ESTAMOS EN CONTACTO</span>

    <h2>¿Tienes alguna pregunta?</h2>

    <p>
      Encuentra más contenido, novedades y tutoriales
      en nuestros canales.
    </p>

    <div class="contact-actions">

      <a class="primary-button"
         href="https://youtube.com/@infinitodinero"
         target="_blank"
         rel="noopener noreferrer">
        ▶ YouTube
      </a>

      <a class="secondary-button"
         href="https://t.me/TU_CANAL"
         target="_blank"
         rel="noopener noreferrer">
        ➤ Telegram
      </a>

    </div>

  </section>

</main>


<!-- FOOTER -->
<footer class="site-footer">

  <a href="#inicio" class="logo footer-logo">
    <span class="logo-icon">∞</span>
    <span>INFINITO <b>DINERO</b></span>
  </a>

  <p>
    Información, guías y oportunidades
    para ganar dinero por Internet.
  </p>

  <div class="footer-links">
    <a href="#inicio">Inicio</a>
    <a href="#categorias">Categorías</a>
    <a href="#trading">Trading</a>
    <a href="#contacto">Contacto</a>
  </div>

  <div class="footer-social">

    <a href="https://youtube.com/@infinitodinero"
       target="_blank"
       rel="noopener noreferrer">
      ▶ YouTube
    </a>

    <a href="https://t.me/TU_CANAL"
       target="_blank"
       rel="noopener noreferrer">
      ➤ Telegram
    </a>

  </div>

  <small>
    © 2026 INFINITO DINERO. Todos los derechos reservados.
  </small>

</footer>


<style>

/* CONFIGURACIÓN GENERAL */

:global(*) {
  box-sizing: border-box;
}

:global(html) {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

:global(body) {
  margin: 0;
  background: #070B16;
  color: #F4F6FA;
  font-family: Arial, Helvetica, sans-serif;
}

:global(a) {
  color: inherit;
  text-decoration: none;
}

:global(a:focus-visible) {
  outline: 2px solid #F5B936;
  outline-offset: 4px;
}


/* CABECERA */

.header {
  min-height: 82px;
  padding: 12px 5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  background: rgba(7,11,22,.97);
  border-bottom: 1px solid #263B5B;
  position: relative;
  z-index: 10;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 15px;
  letter-spacing: 1px;
  font-weight: 700;
  white-space: nowrap;
}

.logo b,
.logo-icon {
  color: #F5B936;
}

.logo-icon {
  font-size: 39px;
  text-shadow: 0 0 18px #087BFF88;
}

.header-navigation {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22px;
  flex: 1;
  min-width: 0;
}

nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(14px, 2vw, 28px);
  white-space: nowrap;
}

nav a {
  color: #D0D7E5;
  font-size: 13px;
  font-weight: 600;
  transition: color .2s;
}

nav a:hover {
  color: #F5B936;
}


/* BOTONES REDES SOCIALES */

.social-links {
  display: flex;
  align-items: center;
  gap: 10px;
  padding-left: 18px;
  border-left: 1px solid #283754;
}

.social-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 13px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
  transition: .2s ease;
}

.social-icon {
  font-size: 13px;
}

.youtube {
  color: white;
  background: #C92D3C;
}

.telegram {
  color: white;
  background: #168BCB;
}

.social-button:hover {
  transform: translateY(-2px);
  filter: brightness(1.15);
}


/* PORTADA */

.hero {
  min-height: 550px;
  padding: 82px 9%;
  display: grid;
  grid-template-columns: 1.15fr .85fr;
  align-items: center;
  gap: 55px;
  background: radial-gradient(
    ellipse at 80% 40%,
    #102B52 0%,
    #0A1428 38%,
    #070B16 72%
  );
}

.eyebrow {
  color: #39A4FF;
  font-size: 11px;
  letter-spacing: 2px;
  font-weight: 800;
}

h1 {
  font-size: clamp(38px, 5vw, 62px);
  line-height: 1.1;
  letter-spacing: -2px;
  margin: 24px 0;
  max-width: 660px;
}

h1 span {
  color: #F5B936;
}

.hero-content > p,
.section-heading > p,
.proof-content > p,
.tutorials > p,
.contact-section > p {
  color: #A6B1C4;
  line-height: 1.8;
  font-size: 15px;
  max-width: 550px;
}

.hero-actions,
.contact-actions {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  margin-top: 30px;
}

.primary-button,
.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 13px 20px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 700;
  transition: .2s;
}

.primary-button {
  background: linear-gradient(110deg,#F8D36B,#D99A20);
  color: #07101D;
  box-shadow: 0 7px 24px #D99A2028;
}

.primary-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 28px #D99A2044;
}

.secondary-button {
  border: 1px solid #31517E;
  color: #E2EAF7;
  background: #0C1830;
}

.secondary-button:hover {
  border-color: #2998FF;
  color: #69BDFF;
}

.hero-note {
  margin-top: 40px;
  color: #8D9BB2;
  font-size: 10px;
  letter-spacing: 1px;
}

.pulse {
  display: inline-block;
  width: 8px;
  height: 8px;
  background: #29A0FF;
  border-radius: 50%;
  margin-right: 8px;
  box-shadow: 0 0 12px #168BFF;
}


/* NUEVO EMBLEMA DE MARCA */

.hero-visual {
  position: relative;
  padding: 25px;
}

.brand-emblem {
  position: relative;
  min-height: 410px;
  padding: 25px;
  overflow: hidden;
  border: 1px solid #D9A52F;
  border-radius: 20px;
  background:
    radial-gradient(ellipse at center,#102B52 0%,#0B1428 58%,#070B16 100%);
  box-shadow:
    0 0 0 4px #0B1B36,
    0 0 0 6px #167BFF,
    0 0 35px #087BFF44,
    inset 0 0 45px #167BFF18;
}

.brand-emblem::before {
  content: "";
  position: absolute;
  inset: 12px;
  border: 1px solid #2876B9;
  border-radius: 15px;
  pointer-events: none;
}

.emblem-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #DCE9FF;
  font-size: 10px;
  letter-spacing: 3px;
  position: relative;
  z-index: 1;
}

.emblem-star {
  color: #F5B936;
  font-size: 20px;
}

.emblem-globe {
  position: absolute;
  width: 180px;
  height: 180px;
  border: 1px solid #168BFF55;
  border-radius: 50%;
  top: 75px;
  left: 50%;
  transform: translateX(-50%);
  display: grid;
  place-items: center;
  box-shadow: 0 0 35px #087BFF22;
}

.globe-symbol {
  font-size: 95px;
  filter: saturate(1.2);
  opacity: .85;
}

.globe-line {
  position: absolute;
  border: 1px solid #168BFF55;
  border-radius: 50%;
  inset: 12px 40px;
}

.globe-line-two {
  transform: rotate(60deg);
}

.globe-line-three {
  transform: rotate(-60deg);
}

.emblem-infinity {
  position: absolute;
  width: 90%;
  left: 5%;
  top: 125px;
  z-index: 2;
}

.emblem-infinity svg {
  width: 100%;
  overflow: visible;
}

.emblem-title {
  position: absolute;
  top: 270px;
  left: 0;
  width: 100%;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 0;
  font-size: 35px;
  font-weight: 900;
  font-style: italic;
  letter-spacing: 2px;
  text-shadow: 0 4px 8px #000;
}

.emblem-title span {
  color: #F4F6FA;
  -webkit-text-stroke: 1px #7B8798;
}

.emblem-title strong {
  color: #F5B936;
  text-shadow: 0 0 20px #D99A2055;
}

.emblem-divider {
  position: absolute;
  bottom: 67px;
  left: 15%;
  width: 70%;
  height: 2px;
  background: linear-gradient(90deg,transparent,#D9A52F,#168BFF,#D9A52F,transparent);
}

.emblem-bottom {
  position: absolute;
  bottom: 37px;
  left: 10%;
  width: 80%;
  display: flex;
  justify-content: space-between;
  color: #D5E3F8;
  font-size: 9px;
  letter-spacing: 2px;
}

.emblem-bottom span:last-child {
  color: #F5B936;
}

.floating-tag {
  position: absolute;
  padding: 13px 17px;
  background: #111E35;
  border: 1px solid #29466D;
  border-radius: 7px;
  font-size: 12px;
  box-shadow: 0 8px 30px #0008;
  z-index: 3;
}

.tag-one {
  top: 5px;
  right: -10px;
  color: #F5B936;
}

.tag-two {
  bottom: 0;
  left: -5px;
  color: #65B9FF;
}


/* SECCIONES */

.section {
  padding: 82px 9%;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 30px;
  margin-bottom: 35px;
}

h2 {
  font-size: clamp(28px,4vw,39px);
  letter-spacing: -1px;
  margin: 14px 0;
}


/* CATEGORÍAS */

.category-grid {
  display: grid;
  grid-template-columns: repeat(3,minmax(0,1fr));
  gap: 17px;
}

.category-card {
  min-height: 255px;
  padding: 25px;
  border: 1px solid #263B5B;
  border-radius: 10px;
  background: linear-gradient(145deg,#101B2D,#0C1321);
  transition: .22s;
}

.category-card:hover {
  transform: translateY(-5px);
  border-color: #278FFF;
  box-shadow: 0 14px 35px #006DCE1C;
}

.card-icon {
  font-size: 28px;
  display: block;
  margin-bottom: 25px;
  color: #F5B936;
}

.card-number {
  color: #8192AD;
  font-size: 9px;
  letter-spacing: 1px;
}

.category-card h3 {
  font-size: 19px;
  margin: 13px 0;
}

.category-card p {
  color: #A6B1C4;
  font-size: 12px;
  line-height: 1.7;
  min-height: 60px;
}

.card-link {
  font-size: 11px;
  font-weight: 700;
  color: #55B2FF;
}

.trading-card {
  background: linear-gradient(145deg,#142542,#101728);
  border-color: #A77A2B66;
}


/* PAGOS */

.proof {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 35px;
  background: linear-gradient(110deg,#0D1A30,#101522);
  border-top: 1px solid #29466D;
  border-bottom: 1px solid #29466D;
}

.proof-content {
  max-width: 560px;
}

.proof-content > p {
  margin-bottom: 28px;
}

.proof-symbol {
  width: 270px;
  min-height: 230px;
  border: 1px solid #A77A2B;
  border-radius: 15px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg,#172642,#101725);
}

.proof-symbol span {
  font-size: 90px;
  color: #F5B936;
}

.proof-symbol small {
  color: #A6B1C4;
  letter-spacing: 2px;
  font-size: 9px;
}

.proof-symbol strong {
  color: #F5B936;
  font-size: 12px;
  margin-top: 15px;
}


/* TUTORIALES */

.tutorials {
  text-align: center;
  background: radial-gradient(ellipse at center,#102344 0%,#070B16 68%);
}

.tutorials > p,
.contact-section > p {
  margin: 0 auto 28px;
